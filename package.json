{
  "name": "@jetserge/pi-session-recap",
  "version": "0.5.2",
  "description": "While-you-were-away recap at the end of the transcript when you return to a Pi session. Keeps you in flow when multi-agenting.",
  "license": "MIT",
  "author": "Thomas Mustier",
  "contributors": [
    "Serge Baranov"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "assets/recap.png",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrazyCoder/pi-session-recap.git"
  },
  "bugs": "https://github.com/CrazyCoder/pi-session-recap/issues",
  "homepage": "https://github.com/CrazyCoder/pi-session-recap#readme",
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "image": "https://raw.githubusercontent.com/CrazyCoder/pi-session-recap/main/assets/recap.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.0",
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@earendil-works/pi-tui": "0.87.0",
    "@types/node": "^22.20.2",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:tarball": "node scripts/verify-tarball.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run verify:tarball"
  }
}
